# Optional host overrides. mace start generates and prints a token automatically.
# These are reference values; Mace does not load .env files automatically.
MACE_HTTP_HOST=0.0.0.0
MACE_HTTP_PORT=8080
MACE_AUTH_SECRET=
# MACE_HOME=/path/to/persistent-state
# MACE_DB_PATH=/path/to/mace.db
# MACE_PID_FILE=/path/to/maced.pid
# MACE_LOG_FILE=/path/to/maced.log
# MACE_WEB_DIR=/path/to/web/dist
MACE_FILE_ROOT=/
MACE_MAX_CONCURRENT_AGENTS=10
# Stop agent work when every signed-in device has been silent this long after
# the 10 second ping timeout. 0 stops as soon as possible; off disables it.
MACE_PRESENCE_GRACE_SECONDS=15
# Hard cap and inactivity limit for one agent turn, in minutes.
MACE_TURN_LIMIT_MINUTES=120
MACE_TURN_IDLE_MINUTES=15
# Native output of finished processes is pruned after this many days.
MACE_EVENT_RETENTION_DAYS=14
MACE_NODE_ROLE=worker
MACE_TS_AUTHKEY=
MACE_TS_HOSTNAME=mace-node
MACE_TS_STATE_DIR=./data/tailscale
MACE_TS_EPHEMERAL=true
