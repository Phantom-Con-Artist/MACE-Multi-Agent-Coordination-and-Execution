# =============================================================================
# MACE - Machine Autonomous Control & Execution Configuration Template
# =============================================================================

# Node Identity & Mode ('controller' or 'worker' / 'target')
MACE_NODE_ROLE=controller
MACE_NODE_NAME=local-mace-node
MACE_DATA_DIR=./data

# Network / P2P Configuration (libp2p)
MACE_P2P_LISTEN_ADDRS=/ip4/0.0.0.0/tcp/4001,/ip4/0.0.0.0/udp/4001/quic-v1
MACE_P2P_RELAY_ENABLED=true
MACE_P2P_NAT_PORT_MAPPING=true

# Remote Peer Connection (For 1-to-1 Remote Control)
# Target multiaddr e.g., /ip4/192.168.1.50/tcp/4001/p2p/12D3KooW...
MACE_REMOTE_PEER_ADDR=

# HTTP & WebSocket API Server (go-chi)
MACE_HTTP_HOST=127.0.0.1
MACE_HTTP_PORT=8080
MACE_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Security & Authentication
MACE_AUTH_SECRET=change-this-to-a-secure-random-token-in-production
MACE_TLS_ENABLED=false
MACE_TLS_CERT_FILE=
MACE_TLS_KEY_FILE=

# SQLite Storage
MACE_DB_PATH=./data/mace.db

# Agent & Concurrency Settings
MACE_MAX_CONCURRENT_AGENTS=10
MACE_AGENT_EXEC_TIMEOUT_SECONDS=300
