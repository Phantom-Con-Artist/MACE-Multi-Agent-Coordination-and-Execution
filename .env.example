# =============================================================================
# MACE — Multi-Agent Coordination and Execution Environment Configuration
# =============================================================================

# Node Identity & Role ('controller' or 'worker')
MACE_NODE_ROLE=controller
MACE_NODE_NAME=mace-primary-node
MACE_DATA_DIR=./data

# =============================================================================
# Networking Layer (Tailscale WireGuard Mesh & P2P)
# =============================================================================

# Primary networking mode: 'tailscale' (recommended) or 'libp2p'
MACE_NETWORKING_MODE=tailscale

# Tailscale Embedded tsnet (User-Space, Zero Root / Zero Daemon Required)
# Generate auth key at: https://login.tailscale.com/admin/settings/keys
MACE_TS_AUTHKEY=tskey-auth-kXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXX
MACE_TS_HOSTNAME=mace-node
MACE_TS_CONTROL_URL=https://controlplane.tailscale.com
MACE_TS_STATE_DIR=./data/tailscale
MACE_TS_EPHEMERAL=true
MACE_TS_FUNNEL=false

# Remote Worker Target (Used by Controller Node to dial Worker)
# Worker MagicDNS name or Tailscale IP (e.g., 'mace-worker-1' or '100.x.y.z')
MACE_REMOTE_TS_HOST=mace-worker-1
MACE_REMOTE_TS_PORT=8080

# Fallback P2P / Direct Multiaddr (libp2p mode)
MACE_P2P_LISTEN_ADDRS=/ip4/0.0.0.0/tcp/4001,/ip4/0.0.0.0/udp/4001/quic-v1
MACE_P2P_RELAY_ENABLED=true
MACE_REMOTE_PEER_ADDR=

# =============================================================================
# Local HTTP REST & WebSocket API Server (go-chi)
# =============================================================================
MACE_HTTP_HOST=127.0.0.1
MACE_HTTP_PORT=8080
MACE_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# =============================================================================
# Security & Authorization
# =============================================================================
MACE_AUTH_SECRET=change-this-to-a-secure-random-token-in-production
MACE_TLS_ENABLED=false
MACE_TLS_CERT_FILE=
MACE_TLS_KEY_FILE=

# =============================================================================
# Storage & Concurrency
# =============================================================================
MACE_DB_PATH=./data/mace.db
MACE_MAX_CONCURRENT_AGENTS=10
MACE_AGENT_EXEC_TIMEOUT_SECONDS=3600
