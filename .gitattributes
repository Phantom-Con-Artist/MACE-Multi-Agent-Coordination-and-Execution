# -----------------------------------------------------------------------------
# MACE - Machine Autonomous Control & Execution
# .gitattributes
# -----------------------------------------------------------------------------

# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Go sources
*.go text eol=lf diff=golang
go.mod text eol=lf
go.sum text eol=lf

# Protocol & Schemas
*.proto text eol=lf
*.sql text eol=lf

# Web / Frontend (React, TypeScript, CSS)
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.svg text eol=lf

# Documentation & Config
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.conf text eol=lf
*.env.example text eol=lf
*.sh text eol=lf
Makefile text eol=lf

# Binary Assets & Databases
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.tar binary
*.gz binary
*.zip binary
*.7z binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.exe binary
*.bin binary
*.so binary
*.dylib binary
